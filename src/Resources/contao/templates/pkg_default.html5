<?php declare(strict_types=1);

if (count($this->items)) { ?>
    <ul>
        <?php foreach ($this->items as $value) { ?>
            <li>
                <?= $value['name']; ?><br>
                {{email::<?= $value['email']; ?>}}<br>

                Fingerprint: <a href="<?= $value['url']; ?>"
                    rel="nofollow noopener noreferrer"
                    title="<?= $value['pki']; ?>"
                    target="_blank"
                >
                    <?= $value['fingerprint']; ?>
                </a><br>
                Public Key Server: <a href="<?= $this->keyServer; ?>"
                    rel="nofollow noopener noreferrer"
                    title="<?= $this->keyServer; ?>"
                    target="_blank"
                >
                    <?= $this->keyServer; ?>
                </a>
            </li>
        <?php } ?>
    </ul>
<?php } ?>